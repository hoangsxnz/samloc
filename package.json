{
  "name": "samloc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @samloc/web dev",
    "build": "pnpm --filter @samloc/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy": "pnpm build && pnpm --filter @samloc/worker run deploy"
  }
}
